# Variables de entorno de MatriculAR. Ninguna es un secreto de la aplicación.
# Copiá este archivo como .env (ignorado por git) solo si usás LocalStack; el resto se pasa por
# la terminal o lo define Terraform. Las credenciales de AWS nunca van acá: se obtienen con
# `aws login` y quedan en el perfil local.

# --- Backend local (npm run servir / npm run verificar en backend/) ---
# Contacto en el User-Agent con que el adaptador se identifica ante Ecogas.
# Por defecto: la URL del repositorio.
MATRICULAR_CONTACTO=
# Puerto de `npm run servir`. Por defecto: 3000.
PORT=3000
# Origen admitido por CORS. Por defecto: *.
MATRICULAR_ORIGEN_CORS=*

# --- Lambda en AWS: las define Terraform (infra/modulos/funcion), no hace falta cargarlas a mano ---
# MATRICULAR_ENTORNO=aws
# MATRICULAR_TABLA_CONSULTAS=matricular-aws-consultas
# MATRICULAR_TABLA_CREDENCIALES=matricular-aws-credenciales
# MATRICULAR_TABLA_VERIFICACIONES=matricular-aws-verificaciones
# MATRICULAR_TABLA_EVALUACIONES=matricular-aws-evaluaciones
# MATRICULAR_BUCKET_LECTURAS=matricular-aws-lecturas-<sufijo>

# --- Pruebas ---
# Habilita `npm run test:aws`: contrato de repositorios contra DynamoDB y S3. Crea y borra
# sus propias tablas y bucket temporales; está pensada para LocalStack (AWS_ENDPOINT_URL).
# MATRICULAR_PRUEBAS_AWS=1
# Endpoint alternativo de AWS para el SDK, por ejemplo LocalStack:
# AWS_ENDPOINT_URL=http://localhost:4566

# --- Despliegue (scripts/desplegar-aws.sh) ---
# Email de la alerta de presupuesto. Si no está, el script lo pide; nunca se versiona.
# TF_VAR_email_alertas=

# --- LocalStack (opcional, no se usó en la entrega) ---
LOCALSTACK_AUTH_TOKEN=
