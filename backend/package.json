{
  "name": "matricular-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fuente-real": "vitest run --config vitest.fuente-real.config.ts",
    "test:aws": "MATRICULAR_PRUEBAS_AWS=1 vitest run compartido/test/adaptadores/repositorios-aws.integracion.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "verificar": "tsx verificacion/src/cli.ts",
    "servir": "tsx verificacion/src/servidor-local.ts",
    "empaquetar": "node scripts/empaquetar.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "zod": "^4.6.7"
  }
}
